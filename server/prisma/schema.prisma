generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reference Data
// ---------------------------------------------------------------------------

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 3 Issue 2 — User Model
//
// Replaces the temporary Lab 2 DevelopmentRequester model.
// Existing DevelopmentRequester data will be preserved by the migration.
// ---------------------------------------------------------------------------

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(REQUESTER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Tickets submitted by this User.
  ticketsRequested Ticket[] @relation("TicketRequester")

  // Tickets assigned to this User as operational owner.
  ticketsOwned Ticket[] @relation("TicketOwner")

  publicComments PublicComment[]
  internalNotes  InternalNote[]

  @@index([role])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Ticket
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model Ticket {
  id           Int    @id @default(autoincrement())
  ticketNumber String @unique

  // Lab 3: Requester is now a User.
  requesterId Int
  requester   User @relation("TicketRequester", fields: [requesterId], references: [id])

  // Lab 3: operational owner.
  // null = unassigned.
  ownerId Int?
  owner   User? @relation("TicketOwner", fields: [ownerId], references: [id])

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  relatedSystemId Int
  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  summary           String
  description       String
  requestedPriority Priority

  // Application code must explicitly copy requestedPriority into itPriority
  // when creating a new Lab 3 Ticket.
  itPriority Priority @default(MEDIUM)

  status TicketStatus @default(NEW)

  // Requester indication only; this does not formally resolve the Ticket.
  problemAppearsResolved   Boolean   @default(false)
  problemAppearsResolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Preserve Lab 2 attachments.
  attachments Attachment[]

  // Lab 3 communication.
  publicComments PublicComment[]
  internalNotes  InternalNote[]

  @@index([requesterId])
  @@index([ownerId])
  @@index([status])
  @@index([categoryId])
  @@index([requestedPriority])
  @@index([itPriority])
}

// ---------------------------------------------------------------------------
// Lab 2 Issue 6 — Attachments
//
// Keep the existing Lab 2 structure/data.
// ---------------------------------------------------------------------------

model Attachment {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  fileName       String
  storedFileName String @unique
  mimeType       String
  sizeBytes      Int

  createdAt DateTime @default(now())

  isRemoved     Boolean   @default(false)
  removedAt     DateTime?
  removedReason String?

  @@index([ticketId])
  @@index([removedAt])
}

// ---------------------------------------------------------------------------
// Lab 3 — Public Comments
//
// Public Comments are append-only.
// Authorization is implemented in later Issues.
// ---------------------------------------------------------------------------

model PublicComment {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Lab 3 — Internal Notes
//
// Internal Notes are append-only.
// Authorization is implemented in later Issues.
// ---------------------------------------------------------------------------

model InternalNote {
  id Int @id @default(autoincrement())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
}
